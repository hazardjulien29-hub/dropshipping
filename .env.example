# Copie ce fichier vers .env (local) ou ajoute les mêmes noms
# dans Cursor → Cloud Agents → Secrets.
# Ne commite jamais .env.

# --- n8n ---
# URL de l'instance, SANS /api/v1 à la fin.
# Cloud : https://TON-SOUS-DOMAINE.app.n8n.cloud
# Self-host : https://n8n.ton-domaine.com
N8N_BASE_URL=
N8N_API_KEY=

# --- Airtable ---
# Token : https://airtable.com/create/tokens
# Base ID : dans l'URL de la base, commence par app (ex. appXXXXXXXXXXXXXX)
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# --- Shopify ---
# Domaine : ta-boutique.myshopify.com  (ou juste ta-boutique)
SHOPIFY_STORE_DOMAIN=

# Méthode 2026 (recommandée) : app Dev Dashboard
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Ancienne méthode : token Admin shpat_... si tu en as encore un
# SHOPIFY_ADMIN_API_TOKEN=
